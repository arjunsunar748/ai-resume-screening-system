# Application Setup
APP_NAME="AI Resume Screening & ATS System"
PROJECT_NAME="AI Resume Screening & ATS System"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (Neon PostgreSQL Primary)
DATABASE_URL="postgresql://user:test123@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Database Configuration (Local Fallback / Alternative)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="test123"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="ats_db"

# Security & CORS
